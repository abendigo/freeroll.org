## App

# Public base URL used in magic-link email links
APP_BASE_URL=https://freeroll.org  # optional, defaults to https://freeroll.org

## Database (Turso / libSQL)

# Leave both unset for local dev — falls back to a local SQLite file at ./data/app.db,
# no Turso account needed to develop. Only production needs a real database:
#   turso db create freeroll
#   turso db show freeroll --url
#   turso db tokens create freeroll
TURSO_DATABASE_URL=  # optional, e.g. libsql://freeroll-<org>.turso.io
TURSO_AUTH_TOKEN=  # optional

## Email (Resend)

# Resend API key for sending magic-link sign-in emails
RESEND_API_KEY=  # required

# Sender name and address — freeroll.org must be a verified sending domain in Resend
FROM_ADDRESS=Freeroll <hello@freeroll.org>  # required
