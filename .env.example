## Database (Turso / libSQL)

# Leave both unset for local dev — falls back to a local SQLite file at ./data/app.db,
# no Turso account needed to develop. Only production/preview environments need a real
# database:
#   turso db create freeroll
#   turso db show freeroll --url
#   turso db tokens create freeroll
TURSO_DATABASE_URL=  # optional, e.g. libsql://freeroll-<org>.turso.io
TURSO_AUTH_TOKEN=  # optional

## App

# Public base URL used in magic-link email links
APP_BASE_URL=https://freeroll.org  # optional, defaults to https://freeroll.org

# When "true", every route responds with a static "coming soon" page instead of the real site
# (see src/hooks.server.ts). Off by default — unset locally and on PR previews so development
# and review aren't gated.
COMING_SOON=  # optional, "true" to hide the site

# Bypass for COMING_SOON: visiting /?preview=<this value> once sets a cookie that lets that
# browser through the gate from then on. Required for the bypass to work at all — leave unset
# and there's no way past the gate short of turning COMING_SOON off. Generate with e.g.
# `openssl rand -hex 20`.
PREVIEW_SECRET=  # optional, required only if COMING_SOON=true and you want to bypass it

# Secret key for HMAC-hashing emails and IPs before they're ever written to the database
# (see src/lib/server/auth/hash.ts). Falls back to an insecure hardcoded value in local dev
# if unset — never leave this unset in production or preview environments.
HASH_SECRET=  # required in production/preview

## Email (Resend)

# Resend API key for sending magic-link sign-in emails. If unset, dev mode logs the email to
# the console instead of sending it, so the sign-in flow is testable without a Resend account.
RESEND_API_KEY=  # required in production/preview

# Sender name and address — freeroll.org must be a verified sending domain in Resend
FROM_ADDRESS=Freeroll <hello@freeroll.org>  # optional, has a fallback

## Analytics (Umami)

# Both unset by default — local dev and PR previews deliberately have no tracking, so test
# traffic never pollutes real analytics. Only production sets these (see deploy-app.yml).
PUBLIC_UMAMI_URL=https://analytics.oosterveld.org  # optional
PUBLIC_UMAMI_WEBSITE_ID=  # optional

## Error tracking (Bugsink, self-hosted, Sentry-API-compatible)

# Unset by default, same shape as the Umami vars above — see hooks.server.ts/hooks.client.ts.
# Create a project at the Bugsink instance to get a DSN; it's a public-safe value (identifies
# where to send events, doesn't grant read access), not a secret.
PUBLIC_SENTRY_DSN=  # optional, e.g. https://<key>@bugs.oosterveld.org/<project-id>

# Buildtime only, used by vite.config.ts to upload source maps so stack traces resolve to real
# source instead of minified bundles. Unset means source maps just don't get uploaded — errors
# still report fine, just harder to read. org/project/url are read directly from the env by the
# underlying @sentry/vite-plugin, so only the token needs to land here.
SENTRY_AUTH_TOKEN=  # buildtime optional
SENTRY_ORG=  # buildtime optional
SENTRY_PROJECT=  # buildtime optional
SENTRY_URL=https://bugs.oosterveld.org  # buildtime optional
