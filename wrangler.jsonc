{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "freeroll-app",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	// Read by @sentry/sveltekit's Cloudflare handle (initCloudflareSentryHandle) for release
	// info — see hooks.server.ts and discoveries/sentry-sveltekit-cloudflare-workers.md.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	}
}
