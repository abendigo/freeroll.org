    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "kysely": "^0.28.14",
    "obscenity": "^0.4.6",
    "resend": "^6.9.4"
